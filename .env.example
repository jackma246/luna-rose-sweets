# Dip & Sprinkle environment template

# Existing admin login password/session settings are configured in Railway.
ADMIN_PASSWORD=
# Required, at least 32 random characters. No fallback: if unset or shorter,
# admin login returns 503 and every admin session is rejected.
ADMIN_SESSION_SECRET=
# Optional, defaults to 1. Change it to sign out every admin session at once.
ADMIN_SESSION_VERSION=1

# Optional admin-equivalent API token for Sunjae.
# Never commit a real value. Set the real token in Railway and Sunjae's private env only.
SUNJAE_ADMIN_API_TOKEN=
# Optional read-only token for Sunjae: GET requests only, writes get 403.
SUNJAE_ADMIN_API_READ_TOKEN=
DIPSPRINKLE_ADMIN_BASE_URL=https://dipsprinkle.com

# Facebook Marketplace webhook. FB_APP_SECRET is required for the webhook:
# without it every POST is refused with 403 (signatures cannot be verified).
FB_APP_SECRET=
